Package: rbgm
Type: Package
Title: Read and Convert 'Atlantis' Box Geometry Model (BGM) Files
Version: 0.2.0.9001
Authors@R: c(
    person("Michael D.", "Sumner", email = "mdsumner@gmail.com", role = c("aut", "cre")),
    person("Department of Climate Change, Energy, the Environment and Water",
